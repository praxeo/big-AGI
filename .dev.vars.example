# Local Cloudflare Workers preview env (used by `npm run cf:preview`).
# Copy to `.dev.vars` (gitignored) and fill in what you need. In production, set these as
# Worker secrets instead: `wrangler secret put OPENAI_API_KEY` (or via the Cloudflare dashboard).
#
# These are the same server-side variables documented in docs/environment-variables.md and
# validated in src/server/env.server.ts - all optional. Add only the providers you use.

# Marks the Worker preview as a development build for OpenNext.
NEXTJS_ENV=development

# --- Example LLM provider keys (all optional) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# GROQ_API_KEY=...

# --- Web browsing (src/modules/browse) ---
# Remote Chrome/Chromium websocket endpoint, or use the Cloudflare Browser Rendering
# binding instead (see wrangler.jsonc + docs/deploy-cloudflare.md).
# PUPPETEER_WSS_ENDPOINT=wss://...

# --- Speech-to-text routes (app/api/stt/*) ---
# STT_API_KEY=sk-...
# ELEVENLABS_API_KEY=...

# --- Sharing / ChatGPT-share import (Prisma over Postgres, optional) ---
# POSTGRES_PRISMA_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...
